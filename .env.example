# .env.example — copy to .env and fill in. Never commit .env.

# Test wallet only. Same key works on all chains (same address, fund each chain).
PRIVATE_KEY=0x...

# Chains
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/

# Watched ERC-20 on Sepolia (example: D3RT test token)
TOKEN=0x259d2fb64231d85e639d1074fa724bcdf29a4ed9

# Guarded wallet (transfers FROM this address are watched)
WATCH=0x655A39A04B65F2EEED8F1fcc6665ee4DFf15d28A

# Destination callback proxy (Sepolia)
CALLBACK_PROXY=0xAa14d9Cd0f788Ca23d11805986C1d8bd035D23b4

# Optional tuning (defaults in script)
THRESHOLD=5000000000000000000
MAX_ALERTS=5
MAX_PER=100000000000000000000
MAX_TOTAL=200000000000000000000
GAS_LIMIT=1000000
REACTIVE_FUND=0.5ether
CALLBACK_FUND=0.02ether
