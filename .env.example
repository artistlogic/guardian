# .env.example — copy to .env, then fill in the values.
#
# SECURITY
#   - .env is listed in .gitignore. Never commit it.
#   - Use a TEST wallet only. This example never contains a real key.
#   - Safer alternative for local signing:
#       cast wallet import sentry-test --interactive
#       forge script ... --account sentry-test
#     (keystore is encrypted; the key never appears in a file or shell history)
#
# REQUIRED: fill these in
PRIVATE_KEY=0x...                                   # test wallet private key
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/
WATCH=0x...                                         # guarded wallet (transfers from it are watched)
TOKEN=0x259d2fb64231d85e639d1074fa724bcdf29a4ed9    # ERC-20 on Sepolia (example: D3RT test token)

# Destination callback proxy (Sepolia) — fixed per network
CALLBACK_PROXY=0xAa14d9Cd0f788Ca23d11805986C1d8bd035D23b4

# Optional tuning (defaults used by script/deploy.sh if omitted)
THRESHOLD=5000000000000000000      # 5 tokens at 18 decimals
MAX_ALERTS=5
MAX_PER=100000000000000000000      # 100 tokens
MAX_TOTAL=200000000000000000000    # 200 tokens
GAS_LIMIT=1000000
REACTIVE_FUND=0.5ether
CALLBACK_FUND=0.02ether
